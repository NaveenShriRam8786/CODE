#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main()
{
    vector<int> v = {50, 10, 40, 20, 30};

    sort(v.begin(), v.end());

    cout << "Sorted elements: ";

    for (int x : v)
        cout << x << " ";

    cout << "\nMaximum: "
         << *max_element(v.begin(), v.end());

    cout << "\nMinimum: "
         << *min_element(v.begin(), v.end());

    return 0;
}
